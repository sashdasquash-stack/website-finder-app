# SerpAPI key — fetches Google Maps Local Pack results.
# Get a free key (100 searches/month, no credit card):
#   1. Sign up at https://serpapi.com
#   2. Find your API key in the dashboard
#   3. Copy this file to .env and paste the key below
SERPAPI_API_KEY=

# Optional access password. If set, all searches/contacted endpoints
# require this password (sent as x-access-password header by the frontend).
# Leave blank for no gate (local dev). Set to a strong value before deploying
# publicly so visitors can't burn your SerpAPI quota.
LEAD_FINDER_PASSWORD=
